# Supabase Credentials
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Firebase Credentials
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Google OAuth web client id — used only by the Android/Capacitor sign-in path
# (passed as the plugin's serverClientId), and by Google One Tap if ever added.
# The web sign-in flow does not need it: Firebase manages its own OAuth client.
VITE_GOOGLE_CLIENT_ID=your-project-number-hash.apps.googleusercontent.com
