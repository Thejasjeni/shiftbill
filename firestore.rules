rules_version = '2';

// ============================================================================
// SwiftBill — Firestore access rules (LIVE)
//
// SINGLE-USER / QUICK START. The app talks to Firestore straight from the
// browser with no sign-in, so these rules mirror the policy the app had on
// Supabase (anon role = full access). Anyone with the project id and the
// (public) web API key can read and write this data.
//
// There is deliberately no catch-all `match /{document=**}`: Firestore already
// denies every path no rule matches, so one would only be redundant. (An
// earlier version of this file carried `allow read, write: if false` on a
// wildcard; the Rules testing API shows it did NOT block these collections —
// matching rules are combined, and a grant wins — so removing it was a
// clean-up, not a fix. See firestore.rules.owner-scoped for the target state
// once sign-in is live.)
//
// Deploy with:  firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /transactions/{doc} {
      allow read, write: if true;
    }

    match /inventory/{doc} {
      allow read, write: if true;
    }

    match /vendors/{doc} {
      allow read, write: if true;
    }

    // The business profile: the shop's own identity (name, GSTIN, UPI id, and
    // the bill's discount and tax rates). One document per account —
    // settings/<uid> — and the shared settings/businessProfile while signed out.
    match /settings/{doc} {
      allow read, write: if true;
    }
  }
}
