rules_version = '2';

// ============================================================================
// SwiftBill — Firestore rules, OWNER-SCOPED (staged, NOT released)
//
// This is the ruleset the app needs once Google sign-in is live: every
// document carries an `ownerId`, and only the signed-in owner can read or
// write it. It is staged in this file rather than released, because releasing
// it before anyone can sign in would lock every existing document away.
//
// Verified with the Firebase Rules testing API — which can simulate incoming
// writes and auth, but NOT an existing stored document:
//
//   create with the caller's own uid ................. allowed
//   create with no ownerId ........................... denied
//   create stamped with someone else's uid ........... denied
//   anonymous create / read / update / delete ......... denied  (every collection)
//
// NOT yet exercised: the read and legacy-claim branches, which depend on the
// stored document's ownerId. Those must be proven against the live database
// with a signed-in user before this file is released.
//
// To go live: rename over firestore.rules (or point firebase.json at it), then
// `firebase deploy --only firestore:rules`. The app already stamps ownerId on
// every write and filters every query by it; the business profile is addressed
// per account (settings/<uid>) for the same reason.

// The `resource == null` arm on /settings reads is what lets a first sign-in
// read its own (not yet existing) profile and then seed it. That a missing
// document really is a null resource was confirmed against the live project:
// a temporary path whose only grant was `allow read: if resource == null`
// answered an anonymous read of a nonexistent document with 404 (document not
// found), where a path with no rule at all answers 403. The arm is therefore
// sound as a mechanism, but this ruleset under a real sign-in is still staged,
// not proven — the Rules testing API cannot help, since it reports an error for
// any request whose rules touch `resource`.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The stored document belongs to the caller.
    function owned() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // First write by the owner: the document carries their uid.
    function stampedByCaller() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Adopting a legacy document that predates ownership (ownerId is absent).
    function claimingLegacyDoc() {
      return signedIn()
        && resource.data.ownerId == null
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /transactions/{doc} {
      allow read: if owned() || claimingLegacyDoc() || (signedIn() && resource.data.ownerId == null);
      allow create: if stampedByCaller();
      allow update: if owned() || claimingLegacyDoc();
      allow delete: if owned();
    }

    match /inventory/{doc} {
      allow read: if owned() || claimingLegacyDoc() || (signedIn() && resource.data.ownerId == null);
      allow create: if stampedByCaller();
      allow update: if owned() || claimingLegacyDoc();
      allow delete: if owned();
    }

    match /vendors/{doc} {
      allow read: if owned() || claimingLegacyDoc() || (signedIn() && resource.data.ownerId == null);
      allow create: if stampedByCaller();
      allow update: if owned() || claimingLegacyDoc();
      allow delete: if owned();
    }

    // The business profile — one document per account, keyed by the owner's
    // uid, plus the shared document a device with no account writes. Same
    // treatment as the ledger, so releasing this ruleset can't lock the shop's
    // own settings away.
    //
    // Reads here also cover the document NOT existing yet: the app gets the
    // profile before it writes one, and rules see a missing document as a null
    // resource, so the null case must come first — without it a first sign-in
    // could never seed its own profile.
    match /settings/{doc} {
      allow read: if signedIn() && (
        resource == null || owned() || claimingLegacyDoc() || resource.data.ownerId == null
      );
      allow create: if stampedByCaller();
      allow update: if owned() || claimingLegacyDoc();
      allow delete: if owned();
    }
  }
}
